# Infinite Slice 3D Skill — Environment Variables
# Copy this file to .env and fill only the publishing method you choose.

# --- Option A: Publish via n8n / Make / Zapier Webhook (Easiest!) ---
# Receives multipart/form-data with `video` (.mp4) + `metadata` (JSON: caption, handle, object, cuts)
N8N_WEBHOOK_URL=

# --- Option B: Publish Directly via Meta Graph API (Instagram Professional Account) ---
# IG_ACCESS_TOKEN must have instagram_basic, instagram_content_publish permissions
IG_USER_ID=
IG_ACCESS_TOKEN=
# Meta Graph API requires a publicly reachable HTTPS URL for the MP4 video.
# Provide either a public hosting base URL (if you upload output/ to R2/S3) OR Cloudinary credentials:
PUBLIC_VIDEO_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# --- Optional: AI Provider for 24/7 Autonomous Cloud Autopilot (scripts/autopilot-cloud.mjs) ---
# Option 1 (FREE TIER recommended!): Google AI Studio Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: Anthropic Claude API Key (used if GEMINI_API_KEY is empty or AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Force provider: auto | gemini | claude | fallback
AI_PROVIDER=auto

# --- Optional: Custom Chrome/Chromium path for headless rendering ---
CHROMIUM_PATH=
